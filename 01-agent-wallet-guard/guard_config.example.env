# agent-wallet-guard — example configuration
# Copy to your scheduler environment (systemd / cron / agent cron) as env vars,
# or to a .env file sourced by the runner.

# Balance endpoint. Default expects DeepSeek-style JSON:
#   {"balance_infos":[{"currency":"USD","total_balance":12.34}]}
# A bare-number response also works.
WALLET_BALANCE_URL=https://api.deepseek.com/user/balance

# API key: either inline, or name an env var that already carries it.
WALLET_API_KEY=
# WALLET_API_KEY_ENV=DEEPSEEK_API_KEY

# USD floor below which to alert (once / 12h)
WALLET_LOW_BALANCE=2.0
# USD actual burn per UTC day that triggers (once / 4h)
WALLET_DAILY_BURN=1.5

# Optional: sqlite usage DB to attribute burn to a session.
# Table: session_model_usage(session_id, billing_provider, first_seen,
#         cache_read_tokens, input_tokens, output_tokens, reasoning_tokens, api_call_count)
WALLET_USAGE_DB=/var/lib/agent/state.db
WALLET_PROVIDER=deepseek

# State persistence
WALLET_STATE_FILE=~/.cache/agent_wallet_guard.json

# Cron: run every 30 min; empty stdout = silent = nothing is delivered.
